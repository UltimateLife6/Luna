# Copy to .env.local for local development. Replace placeholders. Do not commit real values.

APP_ENV=local
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3010
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=

# Used only by npm run admin:create. Do not invent these, and do not commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=

# Transactional email stays off until a verified sender and provider key are set.
# EMAIL_PROVIDER is resend or sendgrid. Set EMAIL_SENDER_VERIFIED=true only after the provider has verified that domain.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_VERIFIED=
